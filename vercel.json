{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/css/(.*)", "dest": "/css/$1" },
    { "src": "^/js/(.*)", "dest": "/js/$1" },
    { "src": "^/ads/(.*)", "dest": "/ads/$1" },
    { "src": "^/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "^/auth/(.*)", "dest": "/api/auth/$1" },
    { "src": "^/admin/(.*)", "dest": "/api/admin/$1" },
    { "src": "^/doctor/(.*)", "dest": "/api/doctor/$1" },
    { "src": "^/patient/(.*)", "dest": "/api/patient/$1" },
    { "src": "^/pharmacy/(.*)", "dest": "/api/pharmacy/$1" },
    { "src": "^/services/(.*)", "dest": "/api/services/$1" },
    { "src": "^/(contact|blood_donors|blood_donor_add|blood_request_add|drug_search|add_testimonial)\\.php$", "dest": "/api/$1.php" },
    { "src": "^/(.*)$", "dest": "/api/index.php" }
  ]
}
