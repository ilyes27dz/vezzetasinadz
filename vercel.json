{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    { "src": "^/auth/(.*)$", "dest": "/auth/$1" },
    { "src": "^/admin/(.*)$", "dest": "/admin/$1" },
    { "src": "^/doctor/(.*)$", "dest": "/doctor/$1" },
    { "src": "^/patient/(.*)$", "dest": "/patient/$1" },
    { "src": "^/pharmacy/(.*)$", "dest": "/pharmacy/$1" },
    { "src": "^/services/(.*)$", "dest": "/services/$1" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^/css/(.*)$", "dest": "/css/$1" },
    { "src": "^/js/(.*)$", "dest": "/js/$1" },
    { "src": "^/images/(.*)$", "dest": "/images/$1" },
    { "src": "^/ads/(.*)$", "dest": "/ads/$1" },
    { "src": "^/uploads/(.*)$", "dest": "/uploads/$1" },
    { "src": "^/(.+\\.php)$", "dest": "/$1" },
    { "src": "^/(.*)$", "dest": "/api/index.php" }
  ]
}
