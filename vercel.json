{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "auth/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "admin/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "doctor/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "patient/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "pharmacy/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "services/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/css/(.*)", "dest": "/css/$1" },
    { "src": "^/js/(.*)", "dest": "/js/$1" },
    { "src": "^/ads/(.*)", "dest": "/ads/$1" },
    { "src": "^/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "^/(.*\\.php)$", "dest": "/$1" }
  ]
}
